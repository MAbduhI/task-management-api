# Application
APP_ENV=development
PORT=8080
LOG_LEVEL=info
LOG_FORMAT=json

# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=task_db
DB_SSLMODE=disable

# Redis
REDIS_HOST=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# Security
JWT_SECRET=super-secret-jwt-key-replace-in-production
JWT_EXPIRY_HOURS=24
